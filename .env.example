ENVIRONMENT=development
ENABLE_DOCS=true
PUBLIC_FRONTEND_ORIGIN=https://example.com
ADMIN_FRONTEND_ORIGIN=https://example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-CSRF-Token,X-Request-ID
DOMAIN_NAME=example.com
ADMIN_BASE_PATH=/admin
ENABLE_HTTPS=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=portfolio
POSTGRES_SUPERUSER_NAME=portfolio_bootstrap
POSTGRES_SUPERUSER_PASSWORD=change-me-bootstrap
DB_APP_READ_USERNAME=portfolio_app_read
DB_APP_READ_PASSWORD=change-me-read
DB_APP_WRITE_USERNAME=portfolio_app_write
DB_APP_WRITE_PASSWORD=change-me-write
DB_APP_ADMIN_USERNAME=portfolio_app_admin
DB_APP_ADMIN_PASSWORD=change-me-admin

REDIS_URL=redis://redis:6379/0
REDIS_PUBLIC_PORTFOLIO_TTL_SECONDS=300
REDIS_PROJECT_LIST_TTL_SECONDS=300

AUTH_LOGIN_RATE_LIMIT_COUNT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_IP_RATE_LIMIT_COUNT=20
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_API_RATE_LIMIT_COUNT=200
AUTH_API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=3600
AUTH_RATE_LIMIT_KEY_PEPPER=change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_SECRET=change-me-admin-session-secret
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_NAME=portfolio_admin_session
ADMIN_SESSION_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SECURE=false
RESUME_IMPORT_PYTHON_BINARY=python
RESUME_IMPORT_PYTHONPATH=tools/cv-importer/src
RESUME_IMPORT_CLI_MODULE=portfolio_cv_importer.api.cli.convert_source_to_portfolio
RESUME_IMPORT_WORKDIR=.
RESUME_IMPORT_NATIVE_PDF_BINARY=

ANALYTICS_SESSION_DAILY_RETENTION_DAYS=548
ANALYTICS_SECTION_VIEW_DAILY_RETENTION_DAYS=365
ANALYTICS_SECTION_CLICK_DAILY_RETENTION_DAYS=365
ANALYTICS_EVENT_DEDUPE_WINDOW_SECONDS=30
ANALYTICS_SESSION_DEDUPE_WINDOW_SECONDS=43200
ANALYTICS_TRACK_NON_PRODUCTION=false
ANALYTICS_SPIKE_THRESHOLD=20
ANALYTICS_SPIKE_WINDOW_SECONDS=60
AUDIT_LOG_RETENTION_DAYS=90
BACKUP_STORAGE_PATH=/opt/portfolio/backups
CONTENT_ASSET_STORAGE_PATH=/opt/portfolio/assets
CONTENT_ASSET_MAX_BYTES=20971520
IMPORT_CANDIDATE_RETENTION_DAYS=30
ENABLE_GRAFANA_INTEGRATION=true
GRAFANA_ROOT_URL=https://example.com/grafana/
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

VITE_PUBLIC_API_BASE_URL=https://example.com/api/public
VITE_ADMIN_API_BASE_URL=https://example.com/api/admin
VITE_ENABLE_DYNAMIC_BACKDROP=true
