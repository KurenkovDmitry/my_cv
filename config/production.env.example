ENVIRONMENT=production
ENABLE_DOCS=false
PUBLIC_FRONTEND_ORIGIN=https://kurenkovdmitrii.ru
ADMIN_FRONTEND_ORIGIN=https://kurenkovdmitrii.ru
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-CSRF-Token,X-Request-ID
DOMAIN_NAME=kurenkovdmitrii.ru
ADMIN_BASE_PATH=/admin
ENABLE_HTTPS=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=portfolio
POSTGRES_SUPERUSER_NAME=portfolio_bootstrap
POSTGRES_SUPERUSER_PASSWORD=replace-with-strong-bootstrap-password
DB_APP_READ_USERNAME=portfolio_app_read
DB_APP_READ_PASSWORD=replace-with-strong-read-password
DB_APP_WRITE_USERNAME=portfolio_app_write
DB_APP_WRITE_PASSWORD=replace-with-strong-write-password
DB_APP_ADMIN_USERNAME=portfolio_app_admin
DB_APP_ADMIN_PASSWORD=replace-with-strong-admin-password

REDIS_URL=redis://redis:6379/0
REDIS_PUBLIC_PORTFOLIO_TTL_SECONDS=300
REDIS_PROJECT_LIST_TTL_SECONDS=300

AUTH_LOGIN_RATE_LIMIT_COUNT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_IP_RATE_LIMIT_COUNT=20
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_API_RATE_LIMIT_COUNT=200
AUTH_API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=3600
AUTH_RATE_LIMIT_KEY_PEPPER=replace-with-strong-rate-limit-pepper

ANALYTICS_SESSION_DAILY_RETENTION_DAYS=548
ANALYTICS_SECTION_VIEW_DAILY_RETENTION_DAYS=365
ANALYTICS_SECTION_CLICK_DAILY_RETENTION_DAYS=365
ANALYTICS_EVENT_DEDUPE_WINDOW_SECONDS=30
ANALYTICS_SPIKE_THRESHOLD=20
ANALYTICS_SPIKE_WINDOW_SECONDS=60
AUDIT_LOG_RETENTION_DAYS=90
BACKUP_STORAGE_PATH=/opt/portfolio/backups
IMPORT_CANDIDATE_RETENTION_DAYS=30
ENABLE_GRAFANA_INTEGRATION=false

VITE_PUBLIC_API_BASE_URL=https://kurenkovdmitrii.ru/api/public
VITE_ADMIN_API_BASE_URL=https://kurenkovdmitrii.ru/api/admin
VITE_ENABLE_DYNAMIC_BACKDROP=true
