server {
    listen 80 default_server;
    server_name _ ${DOMAIN_NAME};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://${DOMAIN_NAME}$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name ${DOMAIN_NAME} _;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 8m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options SAMEORIGIN always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /_portfolio_social_meta {
        internal;
        proxy_pass ${API_UPSTREAM}/api/public/portfolio/social-meta;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_intercept_errors on;
        error_page 400 401 403 404 405 422 429 500 501 502 503 504 = @empty_social_meta;
    }

    location @empty_social_meta {
        return 204;
    }

    location = /_grafana_auth {
        internal;
        proxy_pass ${API_UPSTREAM}/api/admin/auth/grafana;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location @grafana_login {
        return 302 ${ADMIN_BASE_PATH}/?returnTo=/grafana/;
    }

    location = /grafana {
        return 301 /grafana/;
    }

    location ^~ /grafana/ {
        auth_request /_grafana_auth;
        auth_request_set $grafana_user $upstream_http_x_authenticated_user;
        error_page 401 = @grafana_login;

        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-WEBAUTH-USER $grafana_user;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /grafana;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location = ${ADMIN_BASE_PATH} {
        return 301 ${ADMIN_BASE_PATH}/;
    }

    location ^~ ${ADMIN_BASE_PATH}/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ ${ADMIN_BASE_PATH}/index.html;
    }

    location / {
        root /usr/share/nginx/html/public;
        ssi on;
        try_files $uri $uri/ /index.html;
    }
}
