{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/portfolio.v1.schema.json",
  "title": "Portfolio v1",
  "type": "object",
  "required": ["version", "profile", "projects", "themes", "localization", "accessibility", "seo"],
  "properties": {
    "version": {
      "const": "portfolio.v1"
    },
    "draft": {
      "type": "boolean"
    },
    "needsManualReview": {
      "type": "boolean"
    },
    "contentAssetsVersion": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "required": ["displayName", "headline", "summary"],
      "properties": {
        "displayName": { "$ref": "#/$defs/localizedText" },
        "headline": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "location": { "$ref": "#/$defs/localizedText" },
        "avatarAsset": { "type": "string" },
        "avatarAssetId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "availability": { "$ref": "#/$defs/localizedText" },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "label", "value", "href"],
            "properties": {
              "kind": { "type": "string", "enum": ["email", "phone", "github", "telegram", "social"] },
              "label": { "type": "string" },
              "value": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "$ref": "#/$defs/localizedText" },
          "programme": { "$ref": "#/$defs/localizedText" },
          "period": { "$ref": "#/$defs/localizedText" },
          "detail": { "$ref": "#/$defs/localizedText" },
          "proofId": { "type": "string" },
          "assetId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "status": { "type": "string", "enum": ["draft", "published", "needs_review"] }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "company": { "$ref": "#/$defs/localizedText" },
          "role": { "$ref": "#/$defs/localizedText" },
          "period": { "$ref": "#/$defs/localizedText" },
          "description": { "$ref": "#/$defs/localizedText" },
          "highlights": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
          "status": { "type": "string", "enum": ["published", "needs_review"] }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "featured": { "type": "boolean" },
          "status": { "type": "string", "enum": ["active", "archived", "draft"] },
          "title": { "$ref": "#/$defs/localizedText" },
          "summary": { "$ref": "#/$defs/localizedText" },
          "category": { "type": "string", "enum": ["commercial", "academic", "hackathon"] },
          "period": { "$ref": "#/$defs/localizedText" },
          "role": { "$ref": "#/$defs/localizedText" },
          "teamSize": { "type": "integer", "minimum": 1 },
          "responsibilities": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
          "achievements": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "label", "href"],
              "properties": {
                "kind": { "type": "string", "enum": ["repository", "case-study", "demo"] },
                "label": { "$ref": "#/$defs/localizedText" },
                "href": { "type": "string" }
              }
            }
          },
          "coverAssetId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
        }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "focusAreas": { "type": "array", "items": { "type": "string" } },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "items"],
            "properties": {
              "id": { "type": "string" },
              "title": { "$ref": "#/$defs/localizedText" },
              "items": {
                "type": "array",
                "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/localizedText" }] }
              }
            }
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "skill", "kind", "title"],
            "properties": {
              "id": { "type": "string" },
              "skill": { "type": "string" },
              "kind": { "type": "string", "enum": ["certificate", "diploma", "registration", "recommendation"] },
              "title": { "$ref": "#/$defs/localizedText" },
              "level": { "$ref": "#/$defs/localizedText" },
              "issuer": { "$ref": "#/$defs/localizedText" },
              "issuedAt": { "type": "string" },
              "validUntil": { "type": "string" },
              "assetHref": { "type": "string" },
              "assetId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
              "note": { "$ref": "#/$defs/localizedText" }
            }
          }
        },
        "proofNote": { "$ref": "#/$defs/localizedText" }
      }
    },
    "themes": {
      "type": "object",
      "required": ["active", "available"],
      "properties": {
        "active": { "type": "string" },
        "available": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "$ref": "#/$defs/localizedText" }
            }
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "required": ["defaultLocale", "supportedLocales"],
      "properties": {
        "defaultLocale": { "type": "string", "enum": ["ru", "en"] },
        "supportedLocales": {
          "type": "array",
          "items": { "type": "string", "enum": ["ru", "en"] }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "speechSynthesisEnabled": { "type": "boolean" },
        "highContrastModeEnabled": { "type": "boolean" },
        "reducedMotionPresetEnabled": { "type": "boolean" }
      }
    },
    "seo": {
      "type": "object",
      "required": ["siteName"],
      "properties": {
        "siteName": { "$ref": "#/$defs/localizedText" },
        "openGraphImage": { "type": "string" },
        "openGraphAssetId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string" },
        "en": { "type": "string" }
      }
    }
  }
}
